# Copy to backend/.env and fill in. Values missing here fall back to the repo-root .env.
# Never commit this file with real values.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list, or * in development
CORS_ORIGIN=http://localhost:5173

# Neon PostgreSQL connection string (Pooled connection, sslmode=require)
DATABASE_URL=
# Scratch Postgres for database tests, never Neon (see README). Leave empty to skip them.
DATABASE_URL_TEST=

# --- Shopify: NUR by Juggun ---
SHOPIFY_SHOP=nurbyjuggun
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Only for an older admin-created custom app (starts with shpat_); leave empty when using Client ID/secret
SHOPIFY_ACCESS_TOKEN=

# --- Shopify: Juggun's Organics ---
SHOPIFY_ORGANICS_SHOP=jugguns-organics
SHOPIFY_ORGANICS_CLIENT_ID=
SHOPIFY_ORGANICS_CLIENT_SECRET=
SHOPIFY_ORGANICS_ACCESS_TOKEN=

# Shopify Admin API version (quarterly releases)
SHOPIFY_API_VERSION=2026-07

# --- PostEx merchant accounts ---
POSTEX_NUR_BY_JUGGUN_TOKEN=
POSTEX_JUGGUNS_ORGANICS_TOKEN=

# PostEx has no sandbox. Booking or cancelling parcels stays off unless this is explicitly true
# in production. Keep it false everywhere else.
POSTEX_ALLOW_WRITES=false

# --- Sign-in (temporary single user until real accounts exist) ---
AUTH_EMAIL=owner@nurorganics.pk
AUTH_PASSWORD=
# Random 32+ char string. Without it, everyone is signed out when the server restarts.
AUTH_SECRET=
AUTH_SESSION_HOURS=12
